<file path="frontend/src/styles/notificationBell.css">
/* src/components/notificationBell.css */

/* =========================================
   CONTENEDOR Y BOTÓN PRINCIPAL
========================================= */
.bell-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.bell-button {
  background: transparent;
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 8px;
  font-size: 1.2rem;
  cursor: pointer;
  position: relative;
  padding: 6px 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s ease;
  outline: none;
  z-index: 99999;
}

.bell-button:hover {
  background: rgba(255, 255, 255, 0.1);
}

.bell-badge {
  position: absolute;
  top: -8px;
  right: -8px;
  background: #ef4444; /* Rojo alerta */
