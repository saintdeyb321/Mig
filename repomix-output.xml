<file path="frontend/src/styles/history.css">
/* =========================================
   DISEÑO INTERNO DEL TICKET (Historial)
   ========================================= */
.max-container { max-width: 1280px; margin: 0 auto; width: 100%; position: relative; }
/* =========================================
   ESTADOS VACÍOS Y DE CARGA
   ========================================= */
.loading-container {
  height: 60vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.loading-icon {
  font-size: 3.5rem; /* Ligeramente más grande para que destaque */
  display: block;
  animation: pulse-animation 1.5s infinite ease-in-out;
}

.loading-text {
  color: var(--text-muted, #64748b);
  font-weight: 600;
  font-size: 1.1rem;
  margin-top: var(--space-sm, 15px); /* Si falla la variable, usa 15px */
}

/* 🚀 FIX: Faltaba la llave de animación para que el icono "respire" */
@keyframes pulse-animation {
  0% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(1.1); }
  100% { opacity: 1; transform: scale(1); }
}

.empty-state { text-align: center; padding: 60px 20px; border-style: dashed; }
.empty-icon { font-size: 3rem; opacity: 0.2; display: block; margin-bottom: 15px; }
.empty-text { color: var(--text-muted); font-size: 1.1rem; font-weight: 500; }

/* Tarjeta del Ticket */
.history-card { padding: 0; overflow: hidden; border: 1px solid var(--border); transition: all 0.2s ease; }
.history-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
.card-anulada { opacity: 0.6; filter: grayscale(0.8); border: 2px dashed var(--border); }

/* Cabecera del Ticket */
.ticket-header { padding: var(--space-md); display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; border-top: 4px solid transparent; }
.border-efectivo { border-top-color: var(--success); }
.border-yape { border-top-color: #9333ea; }
.border-anulada { border-top-color: var(--border); border-top-style: dashed; }

.ticket-info { display: flex; flex-direction: column; gap: 4px; }
.ticket-date-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.ticket-date { font-weight: 700; font-size: 1rem; color: var(--text-main); }
.badge-offline { font-size: 0.65rem; background: var(--bg-app); color: var(--text-muted); padding: 2px 6px; border-radius: 4px; border: 1px solid var(--border); font-weight: bold; }
.ticket-id { font-size: 0.75rem; color: var(--text-muted); font-family: monospace; font-weight: 500; }

.ticket-amount { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; }
.ticket-total { font-weight: 900; font-size: 1.25rem; color: var(--text-main); line-height: 1; }
.card-anulada .ticket-date, .card-anulada .ticket-total { text-decoration: line-through; }

/* Badges de Pago */
.badge-payment { padding: 4px 10px; border-radius: 20px; font-size: 0.7rem; font-weight: 800; text-transform: uppercase; display: flex; align-items: center; gap: 4px; }
.badge-efectivo { background: #d1fae5; color: var(--success); }
.badge-yape { background: #f3e8ff; color: #9333ea; }
.badge-anulada { background: #fef2f2; color: var(--danger); border: 1px solid #fca5a5; }

/* Cuerpo del Ticket (Lista de Productos) */
.ticket-body { background-color: #e9e6e9; padding: var(--space-md); flex: 1; display: flex; flex-direction: column; gap: 12px; }
.ticket-section-title { font-size: 0.7rem; font-weight: 800; color: var(--text-muted); margin: 0; text-transform: uppercase; letter-spacing: 0.5px; }

.ticket-items-list { display: flex; flex-direction: column; }
.ticket-item-row { display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom: 1px dashed var(--border); }
.ticket-item-row:last-child { border-bottom: none; }

.ticket-item-left { display: flex; gap: 10px; align-items: center; flex: 1; }
.item-qty-box { background: var(--card-bg); border: 1px solid var(--border); color: var(--text-main); font-size: 0.75rem; font-weight: 800; padding: 4px 8px; border-radius: 6px; min-width: 34px; text-align: center; }
.item-name-text { color: var(--text-main); font-weight: 600; font-size: 0.95rem; line-height: 1.1; }
.item-subtotal { font-weight: 700; color: var(--text-main); font-size: 0.95rem; white-space: nowrap; margin-left: 10px; }
.card-anulada .item-name-text, .card-anulada .item-subtotal { text-decoration: line-through; }

/* Vuelto */
.ticket-change-row { margin-top: auto; padding-top: 12px; border-top: 1px dashed var(--border); display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem; color: var(--text-muted); }
.ticket-change-row strong { font-weight: 600; color: var(--text-main); }
.change-highlight { font-weight: 800; color: var(--success); background: #d1fae5; padding: 2px 8px; border-radius: 4px; }

/* Footer del Ticket */
.ticket-footer { padding: 12px var(--space-md); border-top: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; gap: 10px; background: var(--card-bg); }
.ticket-cashier { display: flex; align-items: center; gap: 6px; color: var(--text-muted); font-size: 0.85rem; font-weight: 500; }
.cashier-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 120px; }

/* Categoría sutil */
.history-item-category {
  background: var(--primary-light);
  color: var(--primary);
  padding: 2px 6px;
  border-radius: 4px;
  font-size: 0.6rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  box-shadow: none;
}

/* Botón Anular (Compacto) */
.btn-danger-solid {
  background: transparent;
  color: var(--danger);
  border: 1px solid var(--danger);
  padding: 4px 12px;
  border-radius: 6px;
  font-size: 0.75rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s ease;
  min-height: 28px;
  height: 28px;
  box-shadow: none;
}

.btn-danger-solid:hover:not(:disabled) {
  background: var(--danger);
  color: white;
  box-shadow: 0 4px 10px rgba(239, 68, 68, 0.3);
  transform: translateY(-1px);
}

.btn-danger-solid:disabled {
  opacity: 0.5;
  cursor: not-allowed;
  border-color: #fca5a5;
  color: #fca5a5;
}

/* Modales Complementarios para Historial */
.modal-danger { border-top: 5px solid var(--danger); padding: 24px; max-width: 400px; }
.modal-title-danger { margin-top: 0; margin-bottom: 10px; color: var(--text-main); display: flex; align-items: center; gap: 8px; }
.modal-desc { color: var(--text-muted); font-size: 0.95rem; line-height: 1.5; margin-bottom: 24px; }
.modal-actions { display: flex; gap: 10px; justify-content: flex-end; }
.btn-cancel { background: var(--bg-app); color: var(--text-main); border: 1px solid var(--border); padding: 10px 16px; border-radius: 8px; font-weight: 600; cursor: pointer; transition: background 0.2s; }
.btn-cancel:hover { background: var(--border); }
.btn-danger { background: var(--danger); color: white; border: none; padding: 10px 16px; border-radius: 8px; font-weight: 700; cursor: pointer; transition: opacity 0.2s; }
.btn-danger:hover { opacity: 0.8; }

/* =========================================
   📜 MÓDULO: CONTENEDORES DEL HISTORIAL
   ========================================= */
.history-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
  gap: var(--space-md);
}
.history-card {
  display: flex;
  flex-direction: column;
  height: 100%;
}
</file>

<file path="frontend/src/styles/layout.css">
/* =========================================
   1. ESTRUCTURA PRINCIPAL (PC Y MÓVIL)
   ========================================= */
.app-layout {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;  
  height: 100dvh;
  width: 100vw;
  overflow: hidden;
}

.app-main-content {
  background: #fffefa;
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow-y: auto;
  padding: var(--space-md);
  padding-bottom: var(--space-lg);
}

/* =========================================
   2. ESCRITORIO (CONTENEDOR DEL SIDEBAR)
   ========================================= */
.app-sidebar {
  flex: 0 0 var(--sidebar-w);
  width: var(--sidebar-w);

  /* 🚀 TEMA: Degradado sutil Morado/Noche */
  background: linear-gradient(180deg, #341b3a 0%, #43278e 100%);
  border-right: 1px solid rgba(255, 255, 255, 0.05);
  box-shadow: 4px 0 24px rgba(0, 0, 0, 0.15);
  display: flex;
  flex-direction: column;
  padding: var(--space-md);
  z-index: 50;
  height: 100%;
}

.brand-header h2.brand-title {
  color: #ffffff;
  font-size: 1.5rem;
  margin-bottom: var(--space-lg);
}

/* =========================================
   🚀 1. TARJETA DE USUARIO (Efecto Cristal)
   ========================================= */
.user-info-sidebar {
  display: flex;
  align-items: center;
  gap: 12px;
  /* Fondo casi transparente para dejar ver el morado, con un borde de luz */
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.1);
  padding: 12px;
  border-radius: var(--radius);
  margin-bottom: var(--space-lg);
  /* Desenfoque de fondo para dar efecto de cristal */
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

/* El nombre del usuario brilla en blanco */
.user-info-sidebar .user-name {
  color: #ffffff;
  font-weight: 700;
  display: block;
}

/* El correo se atenúa para no competir visualmente */
.user-email {
  font-size: 0.8rem;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.858);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 150px;
}

/* La etiqueta (DUEÑO/CAJERO) más elegante */
.user-badge {
  background: rgba(255, 255, 255, 0.15);
  color: #ffffff;
  border: 1px solid rgba(255, 255, 255, 0.2);
  font-size: 0.7rem;
  font-weight: 700;
  padding: 4px 10px;
  border-radius: 20px;
  text-transform: uppercase;
  display: inline-block;
  margin-top: 6px;
}

/* =========================================
   3. SEMÁFORO DE RED (ONLINE/OFFLINE)
   ========================================= */
.network-status-pill { display: inline-flex; align-items: center; justify-content: center; transition: all 0.3s ease; white-space: nowrap; }
.network-status-pill.online { padding: 0; background: transparent; }
.network-status-pill.offline { gap: 6px; padding: 4px 10px; border-radius: 20px; font-size: 0.65rem; font-weight: 800; text-transform: uppercase; background: #fee2e2; color: #dc2626; border: 1px solid #fca5a5; box-shadow: 0 0 10px rgba(220, 38, 38, 0.2); }
.pulse-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
.network-status-pill.online .pulse-dot { background-color: #22c55e; box-shadow: 0 0 0 2px rgba(34, 197, 94, 0.2); }
.network-status-pill.offline .pulse-dot { background-color: #dc2626; animation: pulse-red-alert 1.5s infinite; }

@keyframes pulse-red-alert {
  0% { box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.5); }
  70% { box-shadow: 0 0 0 5px rgba(220, 38, 38, 0); }
  100% { box-shadow: 0 0 0 0 rgba(220, 38, 38, 0); }
}
.mobile-header { display: none; }

/* =========================================
   4. MÓVIL (UNIFICADO Y BLINDADO)
   ========================================= */
@media (max-width: 900px) {
  .app-layout { flex-direction: column; }
  .app-sidebar { display: none; }
  div.app-main-content { padding: 0; }

/* 🚀 TEMA: CABECERA MÓVIL (Alineada al color morado oscuro) */
  header.mobile-header {
    position: sticky;
    top: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: linear-gradient(90deg, #341b3a 0%, #43278e 100%);
    padding: 10px 15px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    z-index: 100;
    margin: 0;
    width: 100%;
    border-radius: 0;
    gap: 10px;
  }

  h2.mobile-brand {
    margin: 0; font-size: 1.15rem; display: flex; align-items: center; gap: 6px;
    color: #ffffff; /* Letras blancas */
    flex-shrink: 0; white-space: nowrap;
  }

  div.mobile-header-actions { display: flex; align-items: center; justify-content: flex-end; gap: 8px; flex: 1; min-width: 0; }
  .network-status-pill.offline + span.mobile-badge { display: none; }
  span.mobile-badge { margin: 0; font-size: 0.7rem; padding: 3px 6px; flex-shrink: 0; }
  main.content-area { background: #fffefa; padding: var(--space-md); padding-top: var(--space-lg); padding-bottom: calc(var(--bottom-nav-h) + 25px + env(safe-area-inset-bottom)); flex: 1; }

  /* BOTÓN SALIR MÓVIL */
  button.mobile-logout-btn { background-color: #fef2f2; color: #dc2626; border: 1px solid #fca5a5; border-radius: 8px; font-size: 0.85rem; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; gap: 6px; cursor: pointer; height: 34px; min-height: 34px; padding: 0 12px; margin: 0; flex-shrink: 0; white-space: nowrap; }
}
</file>

<file path="frontend/src/styles/loaders.css">
/* src/styles/loaders.css */
/* =========================================
   🛑 1. PANTALLA COMPLETA (App Inicial / Auth)
   ========================================= */
.loader-container {
  position: fixed;
  top: 0; 
  left: 0;
  width: 100vw; 
  height: 100vh;
  display: flex; 
  flex-direction: column; 
  justify-content: center; 
  align-items: center;
  background-color: var(--bg-app, #f8fafc);
  z-index: 9999; 
  gap: 16px; 
}

/* =========================================
   📦 2. DENTRO DE MÓDULOS (POS, Historial, etc)
   ========================================= */
.module-loader {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 100%;
  min-height: calc(100vh - 120px); 
  gap: 16px; 
}

/* =========================================
   🚀 3. EL SPINNER Y EL TEXTO
   ========================================= */
.spinner {
  width: 50px;
  height: 50px;
  border: 4px solid var(--border, #e2e8f0);
  border-top: 4px solid var(--primary, #2563eb);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin: 0; 
  flex-shrink: 0; 
}

.loader-text {
  font-size: 1.1rem;
  color: var(--text-muted, #64748b);
  font-weight: 600;
  text-align: center;
  margin: 0;
  animation: pulse-text 1.5s ease-in-out infinite;
}

@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
@keyframes pulse-text { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
@keyframes fadeInDown {
  from { opacity: 0; transform: translateY(-10px); }
  to { opacity: 1; transform: translateY(0); }
}
</file>

<file path="frontend/src/styles/maintenance.css">
/* src/styles/maintenance.css */

/* --- MODO MANTENIMIENTO --- */
.maintenance-screen {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100dvh;
  /* 🚀 EL CAMBIO: El degradado corporativo exacto de tu empresa */
  background: linear-gradient(180deg, #341b3a 0%, #43278e 100%);
  text-align: center;
  padding: 20px;
}

.maintenance-content {
  width: 100%;
  max-width: 450px; /* Un poco más ajustado para celulares */
  background: #efebeb;
  padding: 35px 25px;
  border-radius: 16px;
  /* Sombra más oscura para que la tarjeta flote sobre el fondo morado */
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
  border-top: 6px solid var(--primary);
  box-sizing: border-box;
}

/* 🚀 FIX: Contenedor para domar al GIF */
.maintenance-media-container {
  display: flex;
  justify-content: center;
  width: 100%;
  margin-bottom: 20px;
}

/* 🚀 FIX: Escalado perfecto del GIF */
.maintenance-gif {
  width: 100%;
  max-width: 220px; /* Tamaño máximo para que no rompa la pantalla */
  height: auto;
  object-fit: cover;
  border-radius: 12px; /* Bordes redondeaditos para que se vea elegante */
}

/* (Mantenemos la clase del icono por si algún día quitas el GIF) */
.maintenance-icon {
  font-size: 5rem;
  display: block;
  margin-bottom: 20px;
}

.maintenance-footer {
  margin-top: 25px;
  color: var(--text-muted);
  font-size: 0.9rem;
  font-weight: 500;
}

/* 🚀 NUEVO/REPASO: Clase específica para el botón centralizado */
.maintenance-btn {
  margin-top: 30px;
  padding: 12px 24px;
  font-size: 1rem;
  /* El mismo morado/azul del fondo corporativo */
  background: #43278e; 
  color: white;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  font-weight: bold;
  /* Sombra sutil para darle profundidad */
  box-shadow: 0 4px 12px rgba(67, 39, 142, 0.25);
  transition: background 0.2s, transform 0.1s;
  display: inline-block;
  box-sizing: border-box;
}

/* Estado al pasar el ratón (un poco más claro) */
.maintenance-btn:hover {
  background: #5438a3; 
}

/* Estado al presionar (Celular/PC) */
.maintenance-btn:active {
  transform: scale(0.97); 
}
