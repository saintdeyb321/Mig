        && d.ledgerVersion == old.ledgerVersion + 1 && p.sourceId == id && p.type == 'payment' && p.amount > 0
        && p.occurredAt == request.time && !exists(/databases/$(database)/documents/payments/$(d.lastPaymentId))
        && d.paidByMethod.diff(old.paidByMethod).affectedKeys().hasOnly([p.method])
        && d.paidByMethod[p.method] == (math.round(old.paidByMethod[p.method] * 100) + math.round(p.amount * 100)) / 100.0
        && contractBalance(d) && d.status == projectedContractStatus(d.balance, old.status);
    }
    function refundSlot(id, d, old, method) {
      let p = getAfter(/databases/$(database)/documents/payments/$(d.cancelOperationId + '_' + method)).data;
      return old.paidByMethod[method] == 0 || (p.sourceId == id && p.method == method && p.type == 'refund'
        && p.amount == -old.paidByMethod[method] && p.occurredAt == request.time && p.operationId == d.cancelOperationId
        && !exists(/databases/$(database)/documents/payments/$(d.cancelOperationId + '_' + method)));
    }
    function cancelSparkContract(id, d, old) {
      return currentRole() == 'dueño' && d.status == 'cancelado' && d.paidTotal == 0 && d.balance == 0
        && d.paidByMethod == {'efectivo': 0, 'yape': 0, 'plin': 0} && d.ledgerVersion == old.ledgerVersion + 1
        && d.cancelOperationId.matches('^[A-Za-z0-9_-]{36}$') && d.voidedBy == request.auth.uid && d.voidedAt == request.time
        && d.voidReason is string && d.voidReason.size() > 0 && d.voidReason.size() <= 1000
        && d.diff(old).affectedKeys().hasOnly(['paidTotal', 'balance', 'status', 'paidByMethod', 'ledgerVersion', 'cancelOperationId', 'voidReason', 'voidedBy', 'voidedAt', 'updatedAt'])
        && refundSlot(id, d, old, 'efectivo') && refundSlot(id, d, old, 'yape') && refundSlot(id, d, old, 'plin');
    }
    function updateSparkContract(id) {
      let d = request.resource.data;
      let old = resource.data;
      return old.get('sparkContractVersion', 0) == 1 && old.status != 'cancelado' && cashActor(old.businessId, old.branchId)
        && d.updatedAt == request.time
        && (positiveContractPayment(id, d, old) || cancelSparkContract(id, d, old)
          || (d.diff(old).affectedKeys().hasOnly(['clientName', 'clientPhone', 'deliveryDate', 'details', 'deliveryType', 'deliveryAddress', 'deliveryCost', 'subtotal', 'total', 'referenceImages', 'balance', 'status', 'updatedAt'])
            && contractFields(d, id) && contractBalance(d) && d.status == projectedContractStatus(d.balance, old.status))
          || (d.diff(old).affectedKeys().hasOnly(['balance', 'status', 'deliveredAt', 'deliveredBy', 'updatedAt'])
            && !old.keys().hasAny(['deliveredAt']) && d.deliveredAt == request.time && d.deliveredBy == request.auth.uid
            && d.status == projectedContractStatus(d.balance, 'entregado') && d.balance == old.balance));
    }
    function sparkPayment(id) {
      let p = request.resource.data;
      let old = get(/databases/$(database)/documents/contracts/$(p.sourceId));
      let after = getAfter(/databases/$(database)/documents/contracts/$(p.sourceId)).data;
      return saleContext(p) && p.runtime == 'spark' && p.sourceType == 'contract' && after.sparkContractVersion == 1
        && after.businessId == p.businessId && after.branchId == p.branchId && p.contractNumber == after.contractNumber
        && p.clientName == after.clientName && p.cashierName is string && p.cashierName.size() <= 250
        && p.occurredAt == request.time && p.createdAt == request.time && p.operationId.matches('^[A-Za-z0-9_-]{36}$')
        && (p.type in ['advance', 'payment']
          ? p.keys().hasOnly(['businessId', 'branchId', 'userId', 'sessionId', 'cashierName', 'sourceType', 'sourceId', 'contractNumber', 'clientName', 'operationId', 'amount', 'method', 'type', 'runtime', 'occurredAt', 'createdAt'])
            && cents(p.amount) && p.amount > 0 && p.method in ['efectivo', 'yape', 'plin'] && id == p.operationId
            && after.lastPaymentId == id && after.updatedAt == request.time
            && (old == null ? p.type == 'advance' && after.ledgerVersion == 1 && after.createdBy == p.userId
              : p.type == 'payment' && old.data.status != 'cancelado' && after.ledgerVersion == old.data.ledgerVersion + 1)
          : p.type == 'refund' && p.keys().hasOnly(['businessId', 'branchId', 'userId', 'sessionId', 'cashierName', 'sourceType', 'sourceId', 'contractNumber', 'clientName', 'operationId', 'amount', 'method', 'type', 'runtime', 'occurredAt', 'createdAt', 'reason', 'reversalScope'])
            && p.amount < 0 && p.amount == -old.data.paidByMethod[p.method] && p.method in ['efectivo', 'yape', 'plin']
            && id == p.operationId + '_' + p.method && after.cancelOperationId == p.operationId
            && after.status == 'cancelado' && after.voidedAt == request.time && after.voidedBy == p.userId
            && after.ledgerVersion == old.data.ledgerVersion + 1 && p.reason == after.voidReason && p.reversalScope == 'contract-method-balance');
    }
    match /users/{userId} {
      allow read: if authenticated() && (request.auth.uid == userId || superadmin()
        || (owner() && sameTenantResource() && tenantEnabled(currentBusiness())));
      allow create: if authenticated() && invitedProfile(userId);
      allow update: if personalUpdate(userId) || managedUserUpdate();
      allow delete: if tenantManager() && resource.data.role != 'superadmin';
    }

    match /invites/{emailId} {
      allow read: if superadmin() || (owner() && sameTenantResource() && tenantEnabled(currentBusiness()))
        || (ownInvitation(emailId) && !hasProfile());
      allow create: if (tenantCreator() && validInvitation(emailId)) || provisionInvite(emailId);
      allow update: if tenantManager() && businessUnchanged() && validInvitation(emailId);
      allow delete: if tenantManager() || (acceptedInvitation(emailId) && tenantEnabled(resource.data.businessId));
    }

    match /licenses/{licenseId} {
      allow read: if superadmin() || (activeUser() && licenseId == currentBusiness());
      allow create: if provisionLicense(licenseId);
      // Dispatch by authority to avoid evaluating administrative receipts for owner reservations.
      allow update: if superadmin() ? (licenseChange(licenseId) || quotaLicenseChange(licenseId)) : branchQuotaChange(licenseId);
      allow delete: if false;
    }

    match /branches/{branchId} {
      allow get: if (resource == null && owner() && tenantEnabled(currentBusiness()))
        || (superadmin() ? platformDataReader() : tenantReader());
      allow list: if superadmin() ? platformDataReader() : tenantReader();
      allow create: if branchCreation(branchId) || provisionBranch(branchId);
      allow update: if branchUpdate(branchId);
      // Inactivate instead: financial history may reference this branch forever.
      allow delete: if false;
    }

    match /categories/{categoryId} {
      allow read: if superadmin() ? platformDataReader() : tenantReader();
      allow create: if tenantCreator() && validNamedRecord() && request.resource.data.keys().hasOnly(['businessId', 'name', 'status']);
      allow update: if tenantManager() && businessUnchanged() && validNamedRecord()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'status']);
      allow delete: if tenantManager();
    }

    match /products/{productId} {
      allow read: if superadmin() ? platformDataReader() : tenantReader();
      allow create: if tenantCreator() && validProduct() && validStock(request.resource.data.stock)
        && request.resource.data.keys().hasOnly(['businessId', 'name', 'price', 'cost', 'stock', 'category', 'status', 'imageUrl', 'lastStockHistory', 'createdAt', 'updatedAt']);
      allow update: if (request.resource.data.diff(resource.data).affectedKeys().hasAny(['posLastSaleId']) && debit(productId))
        || (request.resource.data.diff(resource.data).affectedKeys().hasAny(['posLastVoidSaleId']) && credit(productId))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'price', 'cost', 'stock', 'category', 'status', 'imageUrl', 'lastStockHistory', 'updatedAt'])
        && businessUnchanged() && tenantManager() && validProduct()
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['stock']) || validStock(request.resource.data.stock)));
      allow delete: if tenantManager() && resource.data.get('posStockVersion', {}).size() == 0;
    }

    match /sales/{saleId} {
      // Transactions must be able to check an absent receipt. Existing receipts stay tenant/branch scoped.
      allow get: if activeUser() && (resource == null || permittedFinancialResource());
      allow list: if permittedFinancialResource();
      allow create: if sale(saleId);
      allow update, delete: if false;
    }
    match /pos_sale_groups/{groupId} {
      allow read: if permittedFinancialResource();
      allow create: if saleGroup(groupId);
      allow update, delete: if false;
    }
    match /pos_voids/{saleId} {
      allow get: if activeUser() && (resource == null || permittedFinancialResource());
      allow list: if permittedFinancialResource();
      allow create: if saleVoid(saleId);
      allow update, delete: if false;
    }
    match /pos_void_groups/{groupId} {
      allow read: if permittedFinancialResource();
      allow create: if voidGroup(groupId);
      allow update, delete: if false;
    }

    match /spark_contract_operations/{id} {
      allow get: if activeUser() && (resource == null || permittedFinancialResource());
      allow list: if permittedFinancialResource();
      allow create: if authenticated() && request.resource.data.keys().hasOnly(['businessId', 'branchId', 'userId', 'contractId', 'requestHash', 'createdAt'])
        && request.resource.data.userId == request.auth.uid && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/contracts/$(request.resource.data.contractId)).data.createOperationId == id
        && getAfter(/databases/$(database)/documents/contracts/$(request.resource.data.contractId)).data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/contracts/$(request.resource.data.contractId)).data.createdBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/contracts/$(request.resource.data.contractId)).data.businessId == request.resource.data.businessId
        && getAfter(/databases/$(database)/documents/contracts/$(request.resource.data.contractId)).data.branchId == request.resource.data.branchId
        && getAfter(/databases/$(database)/documents/contracts/$(request.resource.data.contractId)).data.createRequestHash == request.resource.data.requestHash;
      allow update, delete: if false;
    }
    match /contracts/{contractId} {
      // Cleanup can confirm an absent new contract; existing documents remain tenant scoped.
      allow get: if activeUser() && (resource == null || tenantReader() || platformDataReader());
      allow list: if superadmin() ? platformDataReader() : tenantReader();
      allow create: if createSparkContract(contractId);
      allow update: if updateSparkContract(contractId);
      allow delete: if false;
    }

    match /payments/{paymentId} {
      allow get: if activeUser() && (resource == null || permittedFinancialResource());
      allow list: if permittedFinancialResource();
      allow create: if sparkPayment(paymentId);
      allow update, delete: if false;
    }

    match /customers/{customerId} {
      allow read: if superadmin() ? platformDataReader() : tenantReader();
      allow create: if tenantCreator() && validNamedRecord()
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 50
        && request.resource.data.keys().hasOnly(['businessId', 'name', 'phone', 'createdAt', 'updatedAt']);
      allow update: if tenantManager() && businessUnchanged() && validNamedRecord()
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 50
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'updatedAt']);
      allow delete: if tenantManager();
    }

    match /settings/{businessId} {
      // The document ID is the canonical tenant for legacy settings lacking businessId.
      allow read: if superadmin() || (activeUser() && currentRole() in ['dueño', 'cajero'] && businessId == currentBusiness() && tenantEnabled(businessId));
      allow create: if (tenantCreator() && request.resource.data.businessId == businessId && validCompany()
        && request.resource.data.keys().hasOnly(['businessId', 'companyData'])) || provisionSettings(businessId);
      allow update: if owner() && businessId == currentBusiness() && tenantEnabled(businessId)
        && resource.data.get('businessId', businessId) == businessId
        && request.resource.data.businessId == businessId && validCompany()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['businessId', 'companyData']);
      allow delete: if owner() && businessId == currentBusiness() && tenantEnabled(businessId);
    }

    match /daily_stats/{statId} {
      allow get: if activeUser() && (resource == null || permittedFinancialResource());
      allow list: if permittedFinancialResource();
      allow create, update, delete: if false;
    }

    match /cash_sessions/{sessionId} {
      allow get: if (resource == null && activeUser() && currentRole() in ['dueño', 'cajero'] && tenantEnabled(currentBusiness())) || permittedFinancialResource();
      allow list: if permittedFinancialResource();
      allow create: if cashOpening(sessionId);
      // Estimates remain explicitly uncertified; closing creates a barrier for new operations.
      allow update: if cashClosing(sessionId);
      allow delete: if false;
    }

    match /alerts/{alertId} {
      allow create: if hasTenant(request.resource.data) && sameTenantIncoming() && tenantEnabled(currentBusiness())
        && !protectedFinancialAlert(request.resource.data, alertId);
      allow read: if superadmin() || (owner() && sameTenantResource());
      allow update: if tenantManager() && businessUnchanged()
        && ((protectedFinancialAlert(resource.data, alertId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']))
          || (!protectedFinancialAlert(resource.data, alertId)
            && !protectedFinancialAlert(request.resource.data, alertId)));
      allow delete: if false;
    }

    match /active_cash_sessions/{lockId} {
      allow get: if (resource == null && activeUser() && currentRole() in ['dueño', 'cajero'] && tenantEnabled(currentBusiness())) || permittedFinancialResource();
      allow list: if permittedFinancialResource();
      allow create: if newCashLock(lockId);
      allow delete: if releaseCashLock();
      allow update: if false;
    }

    match /audit_events/{eventId} {
      allow read: if superadmin() || (owner() && sameTenantResource());
      allow write: if false;
    }

    function operationNotice(id) {
      let n = request.resource.data;
      let source = n.sourceType == 'sale'
        ? getAfter(/databases/$(database)/documents/sales/$(n.sourceId)).data
        : getAfter(/databases/$(database)/documents/payments/$(n.sourceId)).data;
      return authenticated() && n.sourceType in ['sale', 'payment'] && id == n.sourceType + '_' + n.sourceId
        // Exact equality retains every field/value check with a smaller expression budget.
        && source.userId == request.auth.uid && n == {'businessId': source.businessId, 'branchId': source.branchId,
          'userId': request.auth.uid, 'sourceType': n.sourceType, 'sourceId': n.sourceId,
          'authority': 'informational', 'readAt': null, 'actorName': source.cashierName, 'createdAt': request.time,
          'title': 'Operación registrada', 'message': 'Aviso informativo. Consulta el movimiento confirmado; este aviso no certifica importes.'}
        && (n.sourceType == 'sale' ? source.confirmedAt == request.time && !exists(/databases/$(database)/documents/sales/$(n.sourceId))
          : source.createdAt == request.time && !exists(/databases/$(database)/documents/payments/$(n.sourceId)));
    }
    match /notifications/{notificationId} {
      allow read: if (activeUser() && sameTenantResource() && resource.data.userId == request.auth.uid && tenantEnabled(currentBusiness())) || platformDataReader();
      allow update: if activeUser() && sameTenantResource() && resource.data.userId == request.auth.uid
        && tenantEnabled(currentBusiness())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        && request.resource.data.readAt is timestamp && request.resource.data.readAt == request.time;
      allow create: if operationNotice(notificationId);
      allow delete: if false;
    }

    match /system/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /tenants/{businessId} {
      allow read: if superadmin() || (activeUser() && businessId == currentBusiness());
      allow create: if provisionTenant(businessId);
      allow update, delete: if false;
    }
    match /platform_data_access/{actorId} {
      allow read, delete: if superadmin() && actorId == request.auth.uid;
      allow create, update: if superadmin() && actorId == request.auth.uid
        && request.resource.data.keys().hasOnly(['actorId', 'businessId', 'purpose', 'accessId', 'createdAt'])
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.businessId is string && request.resource.data.businessId.size() > 0
        && request.resource.data.businessId.size() <= 128 && request.resource.data.businessId != 'platform-admin'
        && request.resource.data.purpose in ['export', 'inventory']
        && request.resource.data.accessId.matches('^[A-Za-z0-9_-]{16,100}$')
        && request.resource.data.createdAt == request.time;
    }
    match /platform_jobs/{jobId} {
      allow read: if platformDataReader();
      allow write: if false;
      match /{document=**} {
        allow read: if superadmin() && platformDataScope(get(/databases/$(database)/documents/platform_jobs/$(jobId)).data.businessId);
        allow write: if false;
      }
    }
    match /platform_operations/{id} {
      allow read: if superadmin();
      allow create: if validProvisionReceipt(id) || licenseReceipt(id) || quotaReceipt(id);
      allow update, delete: if false;
    }
    match /owner_email_claims/{email} {
      allow get: if superadmin() || ownInvitation(email);
      allow list: if superadmin();
      allow create: if provisionClaim(email);
      allow update, delete: if false;
    }
    match /platform_audit/{id} {
      allow read: if superadmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
