rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authenticated() {
      return request.auth != null;
    }

    function hasProfile() {
      return authenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeUser() {
      // Existing profiles without status remain compatible; explicit suspension revokes access.
      return hasProfile() && currentUser().get('status', 'activo') == 'activo'
        && currentUser().role in ['superadmin', 'dueño', 'cajero'];
    }

    function currentBusiness() {
      return currentUser().businessId;
    }

    function currentRole() {
      return currentUser().role;
    }

    function owner() {
      return activeUser() && currentRole() == 'dueño';
    }

    function superadmin() {
      return activeUser() && currentRole() == 'superadmin';
    }

    function hasTenant(data) {
      return data.get('businessId', null) is string && data.businessId.size() > 0;
    }

    function sameTenantResource() {
      return activeUser() && resource.data.businessId == currentBusiness();
    }

    function sameTenantIncoming() {
      return activeUser() && hasTenant(request.resource.data)
        && request.resource.data.businessId == currentBusiness();
    }

    function businessUnchanged() {
      return request.resource.data.businessId == resource.data.businessId;
    }

    function tenantReader() {
      return superadmin() || sameTenantResource();
    }

    function tenantCreator() {
      return hasTenant(request.resource.data)
        && (superadmin() || (owner() && sameTenantIncoming()));
    }

    function tenantManager() {
      return superadmin() || (owner() && sameTenantResource());
    }

    function branchAccess(branchId) {
      return superadmin() || (activeUser() && (owner()
        || (currentRole() == 'cajero' && branchId is string && branchId != 'global'
          && branchId == currentUser().get('branchId', null))));
    }

    function branchBelongsTo(businessId, branchId) {
      return branchId is string && branchId.size() > 0 && branchId != 'global'
        && exists(/databases/$(database)/documents/branches/$(branchId))
        && get(/databases/$(database)/documents/branches/$(branchId)).data.businessId == businessId;
    }

    function verifiedEmail() {
      return authenticated() && request.auth.token.get('email', null) is string
        && request.auth.token.get('email_verified', false) == true;
    }

    function ownInvitation(emailId) {
      return verifiedEmail() && emailId == request.auth.token.email;
    }

    function validShift(value) {
      return value == null || (value is string && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'));
    }

    function validAssignment(data) {
      let branchId = data.get('branchId', null);
      return validShift(data.get('shiftStart', null)) && validShift(data.get('shiftEnd', null))
        && ((data.role == 'cajero' && branchBelongsTo(data.businessId, branchId))
          || (data.role == 'dueño' && (branchId == null || branchId == 'global'
            || branchBelongsTo(data.businessId, branchId))));
    }

    function validInvitation(emailId) {
      let data = request.resource.data;
      return data.keys().hasAll(['email', 'businessId', 'role'])
        && data.keys().hasOnly(['email', 'businessId', 'role', 'firstName', 'lastName',
          'branchId', 'shiftStart', 'shiftEnd', 'status', 'createdAt'])
        && hasTenant(data) && data.email == emailId && data.email is string
        && data.role in ['dueño', 'cajero']
        && data.get('firstName', '') is string && data.get('lastName', '') is string
        && data.get('status', 'activo') in ['activo', 'inactivo']
        && validAssignment(data);
    }

    function invitedProfile(userId) {
      let data = request.resource.data;
      let invitation = get(/databases/$(database)/documents/invites/$(request.auth.token.email)).data;
      return verifiedEmail() && userId == request.auth.uid
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && exists(/databases/$(database)/documents/invites/$(request.auth.token.email))
        && data.keys().hasAll(['email', 'businessId', 'role', 'firstName', 'lastName',
          'branchId', 'shiftStart', 'shiftEnd', 'status', 'createdAt'])
        && data.keys().hasOnly(['email', 'businessId', 'role', 'firstName', 'lastName',
          'branchId', 'shiftStart', 'shiftEnd', 'status', 'createdAt'])
        && hasTenant(data) && data.email == request.auth.token.email
        && data.email == invitation.email && data.businessId == invitation.businessId
        && data.role in ['dueño', 'cajero'] && data.role == invitation.role
        && data.branchId == invitation.get('branchId', null)
        && data.shiftStart == invitation.get('shiftStart', null)
        && data.shiftEnd == invitation.get('shiftEnd', null)
        && data.status == invitation.get('status', 'activo') && data.status == 'activo'
        && data.firstName == invitation.get('firstName', '')
        && data.lastName == invitation.get('lastName', '')
        && data.createdAt is string && validAssignment(data);
    }

    function acceptedInvitation(emailId) {
      return ownInvitation(emailId) && hasProfile()
        && currentUser().email == emailId
        && currentUser().businessId == resource.data.businessId
        && currentUser().role == resource.data.role
        && currentUser().get('branchId', null) == resource.data.get('branchId', null)
        && currentUser().get('shiftStart', null) == resource.data.get('shiftStart', null)
        && currentUser().get('shiftEnd', null) == resource.data.get('shiftEnd', null);
    }

    function personalUpdate(userId) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return activeUser() && userId == request.auth.uid
        && changed.hasOnly(['firstName', 'lastName', 'hasAcceptedTerms', 'termsAcceptedAt', 'termsVersion'])
        && data.get('firstName', '') is string && data.get('lastName', '') is string
        && (!changed.hasAny(['hasAcceptedTerms', 'termsAcceptedAt', 'termsVersion'])
          || (data.hasAcceptedTerms == true && data.termsAcceptedAt == request.time
            && data.termsVersion is string));
    }

    function managedUserUpdate() {
      let data = request.resource.data;
      return owner() && sameTenantResource() && resource.data.role != 'superadmin'
        && businessUnchanged() && data.email == resource.data.email
        && data.diff(resource.data).affectedKeys().hasOnly([
          'firstName', 'lastName', 'role', 'branchId', 'shiftStart', 'shiftEnd', 'status'])
        && data.role in ['dueño', 'cajero'] && data.get('status', 'activo') in ['activo', 'inactivo']
        && data.get('firstName', '') is string && data.get('lastName', '') is string
        && validAssignment(data);
    }

    function validProduct() {
      let data = request.resource.data;
      return data.keys().hasAll(['businessId', 'name', 'price', 'stock'])
        && hasTenant(data) && data.name is string && data.name.size() > 0
        && data.price is number && data.price >= 0 && data.stock is map;
    }

    function permittedFinancialResource() {
      return superadmin() || (sameTenantResource() && branchAccess(resource.data.get('branchId', null)));
    }

    function protectedFinancialAlert(data, alertId) {
      return data.get('type', '') in ['VOIDED_SALE', 'VOIDED_CONTRACT']
        || alertId.matches('^VOIDED_(SALE|CONTRACT)_.*')
        || data.keys().hasAny(['saleId', 'contractId']);
    }

    match /users/{userId} {
      allow read: if authenticated() && (request.auth.uid == userId || superadmin()
        || (owner() && sameTenantResource()));
      allow create: if authenticated() && invitedProfile(userId);
      allow update: if personalUpdate(userId) || managedUserUpdate()
        || (superadmin() && businessUnchanged()
          && request.resource.data.email == resource.data.email
          && request.resource.data.role in ['superadmin', 'dueño', 'cajero']);
      allow delete: if superadmin() || (owner() && sameTenantResource() && resource.data.role != 'superadmin');
    }

    match /invites/{emailId} {
      allow read: if superadmin() || (owner() && sameTenantResource())
        || (ownInvitation(emailId) && !hasProfile());
      allow create: if tenantCreator() && validInvitation(emailId);
      allow update: if tenantManager() && businessUnchanged() && validInvitation(emailId);
      allow delete: if tenantManager() || acceptedInvitation(emailId);
    }

    match /licenses/{licenseId} {
      allow read: if superadmin() || (activeUser() && licenseId == currentBusiness());
      allow create, update: if superadmin() && request.resource.data.businessId == licenseId
        && request.resource.data.expiry is timestamp && request.resource.data.status is string;
      allow delete: if superadmin();
    }

    match /branches/{branchId} {
      allow read: if tenantReader();
      allow create: if tenantCreator();
      allow update: if tenantManager() && businessUnchanged();
      allow delete: if tenantManager();
    }

    match /categories/{categoryId} {
      allow read: if tenantReader();
      allow create: if tenantCreator();
      allow update: if tenantManager() && businessUnchanged();
      allow delete: if tenantManager();
    }

    match /products/{productId} {
      allow read: if tenantReader();
      allow create: if tenantCreator() && validProduct() && !request.resource.data.keys().hasAny(['posStockVersion']);
      allow update: if businessUnchanged() && tenantManager() && validProduct()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['posStockVersion']);
      allow delete: if tenantManager();
    }

    match /sales/{saleId} {
      // Transactions must be able to check an absent receipt. Existing receipts stay tenant/branch scoped.
      allow get: if activeUser() && (resource == null || permittedFinancialResource());
      allow list: if permittedFinancialResource();
      allow create, update, delete: if false;
    }

    match /contracts/{contractId} {
      allow read: if tenantReader();
      allow create, update, delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if permittedFinancialResource();
      allow create, update, delete: if false;
    }

    match /customers/{customerId} {
      allow read: if tenantReader();
      allow create: if tenantCreator();
      allow update: if tenantManager() && businessUnchanged();
      allow delete: if tenantManager();
    }

    match /settings/{businessId} {
      // The document ID is the canonical tenant for legacy settings lacking businessId.
      allow read: if superadmin() || (activeUser() && businessId == currentBusiness());
      allow create: if tenantCreator() && request.resource.data.businessId == businessId;
      allow update: if (superadmin() || (owner() && businessId == currentBusiness()))
        && resource.data.get('businessId', businessId) == businessId
        && request.resource.data.businessId == businessId;
      allow delete: if superadmin() || (owner() && businessId == currentBusiness());
    }

    match /daily_stats/{statId} {
      allow get: if activeUser() && (resource == null || permittedFinancialResource());
      allow list: if permittedFinancialResource();
      allow create, update, delete: if false;
    }

    match /cash_sessions/{sessionId} {
      allow read: if permittedFinancialResource();
      // Only backend-authorized windows may support late offline financial writes.
      allow create, update, delete: if false;
    }

    match /alerts/{alertId} {
      allow create: if hasTenant(request.resource.data) && (superadmin() || sameTenantIncoming())
        && !protectedFinancialAlert(request.resource.data, alertId);
      allow read: if tenantManager();
      allow update: if tenantManager() && businessUnchanged()
        && ((protectedFinancialAlert(resource.data, alertId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']))
          || (!protectedFinancialAlert(resource.data, alertId)
            && !protectedFinancialAlert(request.resource.data, alertId)));
      allow delete: if false;
    }

    match /system/{docId} {
      allow read: if true;
      allow write: if superadmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
