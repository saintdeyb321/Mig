rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authenticated() {
      return request.auth != null;
    }

    function hasProfile() {
      return authenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeUser() {
      // Existing profiles without status remain compatible; explicit suspension revokes access.
      return hasProfile() && currentUser().get('status', 'activo') == 'activo'
        && currentUser().role in ['superadmin', 'dueño', 'cajero'];
    }

    function currentBusiness() {
      return currentUser().businessId;
    }

    function currentRole() {
      return currentUser().role;
    }

    function tenantEnabled(businessId) {
      let license = get(/databases/$(database)/documents/licenses/$(businessId)).data;
      let tenant = get(/databases/$(database)/documents/tenants/$(businessId));
      return license.businessId == businessId && license.status == 'activa'
        && license.expiry is timestamp && license.expiry > request.time
        && license.get('tenantStatus', 'active') == 'active'
        && license.get('maintenanceJobId', null) == null
        && (tenant == null || (tenant.data.status == 'active' && tenant.data.get('maintenanceJobId', null) == null));
    }

    function owner() {
      return activeUser() && currentRole() == 'dueño';
    }

    function superadmin() {
      return activeUser() && currentRole() == 'superadmin';
    }

    // Explicit platform data access: one tenant, read-only, ten minutes of server time.
    function platformDataScope(businessId) {
      let access = get(/databases/$(database)/documents/platform_data_access/$(request.auth.uid));
      return superadmin() && access != null && access.data.businessId != 'platform-admin'
        && access.data.actorId == request.auth.uid && access.data.businessId == businessId
        && access.data.purpose in ['export', 'inventory'] && access.data.createdAt is timestamp
        && access.data.createdAt <= request.time && request.time < access.data.createdAt + duration.value(10, 'm');
    }
    function platformDataReader() {
      return superadmin() && platformDataScope(resource.data.businessId);
    }

    function hasTenant(data) {
      return data.get('businessId', null) is string && data.businessId.size() > 0;
    }

    function sameTenantResource() {
      return activeUser() && currentRole() in ['dueño', 'cajero'] && currentBusiness() != 'platform-admin'
        && resource.data.businessId == currentBusiness();
    }

    function sameTenantIncoming() {
      return activeUser() && hasTenant(request.resource.data)
        && request.resource.data.businessId == currentBusiness();
    }

    function businessUnchanged() {
      return request.resource.data.businessId == resource.data.businessId;
    }

    function tenantReader() {
      return sameTenantResource() && tenantEnabled(currentBusiness());
    }

    function tenantCreator() {
      return hasTenant(request.resource.data)
        && owner() && sameTenantIncoming() && tenantEnabled(currentBusiness());
    }

    function tenantManager() {
      return owner() && sameTenantResource() && tenantEnabled(currentBusiness());
    }

    function branchAccess(branchId) {
      return superadmin() || (activeUser() && (owner()
        || (currentRole() == 'cajero' && branchId is string && branchId != 'global'
          && branchId == currentUser().get('branchId', null))));
    }

    function branchBelongsTo(businessId, branchId) {
      return branchId is string && branchId.size() > 0 && branchId != 'global'
        && exists(/databases/$(database)/documents/branches/$(branchId))
        && get(/databases/$(database)/documents/branches/$(branchId)).data.businessId == businessId
        && get(/databases/$(database)/documents/branches/$(branchId)).data.get('status', null) == 'activo';
    }

    function verifiedEmail() {
      return authenticated() && request.auth.token.get('email', null) is string
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function ownInvitation(emailId) {
      return verifiedEmail() && emailId == request.auth.token.email;
    }

    function validShift(value) {
      return value == null || (value is string && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'));
    }

    function validAssignment(data) {
      let branchId = data.get('branchId', null);
      return validShift(data.get('shiftStart', null)) && validShift(data.get('shiftEnd', null))
        && ((data.role == 'cajero' && branchBelongsTo(data.businessId, branchId))
          || (data.role == 'dueño' && (branchId == null || branchId == 'global'
            || branchBelongsTo(data.businessId, branchId))));
    }

    function validInvitation(emailId) {
      let data = request.resource.data;
      return data.keys().hasAll(['email', 'businessId', 'role'])
        && data.keys().hasOnly(['email', 'businessId', 'role', 'firstName', 'lastName',
          'branchId', 'shiftStart', 'shiftEnd', 'status', 'createdAt'])
        && hasTenant(data) && data.email == emailId && data.email is string
        && data.role in ['dueño', 'cajero']
        && data.get('firstName', '') is string && data.get('lastName', '') is string
        && data.get('status', 'activo') in ['activo', 'inactivo']
        && validAssignment(data);
    }

    function invitedProfile(userId) {
      let data = request.resource.data;
      let invitation = get(/databases/$(database)/documents/invites/$(request.auth.token.email)).data;
      return verifiedEmail() && userId == request.auth.uid
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && exists(/databases/$(database)/documents/invites/$(request.auth.token.email))
        && data.keys().hasAll(['email', 'businessId', 'role', 'firstName', 'lastName',
          'branchId', 'shiftStart', 'shiftEnd', 'status', 'createdAt'])
        && data.keys().hasOnly(['email', 'businessId', 'role', 'firstName', 'lastName',
          'branchId', 'shiftStart', 'shiftEnd', 'status', 'createdAt'])
        && hasTenant(data) && data.email == request.auth.token.email
        && data.email == invitation.email && data.businessId == invitation.businessId
        && tenantEnabled(invitation.businessId)
        && data.role in ['dueño', 'cajero'] && data.role == invitation.role
        && data.branchId == invitation.get('branchId', null)
        && data.shiftStart == invitation.get('shiftStart', null)
        && data.shiftEnd == invitation.get('shiftEnd', null)
        && data.status == invitation.get('status', 'activo') && data.status == 'activo'
        && data.firstName == invitation.get('firstName', '')
        && data.lastName == invitation.get('lastName', '')
        && data.createdAt is string && validAssignment(data)
        && !existsAfter(/databases/$(database)/documents/invites/$(request.auth.token.email));
    }

    function acceptedInvitation(emailId) {
      let profile = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return ownInvitation(emailId) && profile.email == emailId
        && profile.businessId == resource.data.businessId && profile.role == resource.data.role
        && profile.get('branchId', null) == resource.data.get('branchId', null)
        && profile.get('shiftStart', null) == resource.data.get('shiftStart', null)
        && profile.get('shiftEnd', null) == resource.data.get('shiftEnd', null);
    }

    function personalUpdate(userId) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return activeUser() && userId == request.auth.uid
        && (superadmin() || tenantEnabled(currentBusiness()))
        && changed.hasOnly(['firstName', 'lastName', 'hasAcceptedTerms', 'termsAcceptedAt', 'termsVersion'])
        && data.get('firstName', '') is string && data.get('lastName', '') is string
        && (!changed.hasAny(['hasAcceptedTerms', 'termsAcceptedAt', 'termsVersion'])
          || (data.hasAcceptedTerms == true && data.termsAcceptedAt == request.time
            && data.termsVersion is string));
    }

    function managedUserUpdate() {
      let data = request.resource.data;
      return owner() && sameTenantResource() && resource.data.role != 'superadmin'
        && tenantEnabled(currentBusiness())
        && businessUnchanged() && data.email == resource.data.email
        && data.diff(resource.data).affectedKeys().hasOnly([
          'firstName', 'lastName', 'role', 'branchId', 'shiftStart', 'shiftEnd', 'status'])
        && data.role in ['dueño', 'cajero'] && data.get('status', 'activo') in ['activo', 'inactivo']
        && data.get('firstName', '') is string && data.get('lastName', '') is string
        && validAssignment(data);
    }

    function validProduct() {
      let data = request.resource.data;
      let costValue = data.get('cost', 0);
      return data.keys().hasAll(['businessId', 'name', 'price', 'stock'])
        && hasTenant(data) && data.name is string && data.name.size() > 0
        && data.name.size() <= 200 && data.price is number && data.price >= 0 && data.price <= 1000000000
        && data.price == math.round(data.price * 100) / 100.0
        && costValue is number && costValue >= 0 && costValue <= 1000000000
        && costValue == math.round(costValue * 100) / 100.0
        && data.get('status', 'activo') in ['activo', 'inactivo'] && data.stock is map;
    }

    function stockValue(stock, key, businessId) {
      let value = stock[key];
      return value is int && value >= 0 && value <= 1000000000
        && ((resource != null && resource.data.stock.get(key, -1) == value) || activeStockBranch(key, businessId));
    }
    function activeStockBranch(key, businessId) {
      let branch = get(/databases/$(database)/documents/branches/$(key));
      return branch != null && branch.data.businessId == businessId && branch.data.get('status', null) == 'activo';
    }
    function stockSlot(stock, keys, index, businessId) {
      return keys.size() <= index || stockValue(stock, keys[index], businessId);
    }
    function validStock(stock) {
      let keys = stock.keys();
      let businessId = currentBusiness();
      return keys.size() > 0 && keys.size() <= 6
        && stockSlot(stock, keys, 0, businessId) && stockSlot(stock, keys, 1, businessId) && stockSlot(stock, keys, 2, businessId)
        && stockSlot(stock, keys, 3, businessId) && stockSlot(stock, keys, 4, businessId) && stockSlot(stock, keys, 5, businessId);
    }
    function validNamedRecord() {
      let data = request.resource.data;
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.get('status', 'activo') in ['activo', 'inactivo'];
    }
    function validCompany() {
      let data = request.resource.data.companyData;
      return data is map && data.keys().hasOnly(['razonSocial', 'ruc', 'direccion', 'telefono'])
        && data.get('razonSocial', '') is string && data.get('razonSocial', '').size() <= 250
        && data.get('ruc', '') is string && data.get('ruc', '').size() <= 30
        && data.get('direccion', '') is string && data.get('direccion', '').size() <= 500
        && data.get('telefono', '') is string && data.get('telefono', '').size() <= 50;
    }

    function permittedFinancialResource() {
      return superadmin() ? platformDataReader() : (sameTenantResource() && branchAccess(resource.data.get('branchId', null)));
    }

    function protectedFinancialAlert(data, alertId) {
      return data.get('type', '') in ['VOIDED_SALE', 'VOIDED_CONTRACT']
        || alertId.matches('^VOIDED_(SALE|CONTRACT)_.*')
        || data.keys().hasAny(['saleId', 'contractId']);
    }

    // Spark provisioning: seven writes, bound by one immutable operation receipt.
    // Receipt validation: six getAfter documents + absent tenant + actor exists/get (<=9).
    // Related creates add receipt before/after; the batch stays below 20 accesses.
    // Positive, partial-bundle and concurrent-admin emulator tests enforce these budgets.
    function provisioning(data) {
      return getAfter(/databases/$(database)/documents/platform_operations/$(request.auth.uid + '_' + data.operationId)).data;
    }
    function newProvision(data) {
      let op = provisioning(data);
      return superadmin() && op.operation == 'createTenant' && op.actorId == request.auth.uid
        && !exists(/databases/$(database)/documents/platform_operations/$(request.auth.uid + '_' + data.operationId))
        && op.createdAt == request.time && op.businessId == data.businessId;
    }
    function validProvisionReceipt(id) {
      let d = request.resource.data;
      return superadmin() && d.operation == 'createTenant' && d.keys().hasOnly(['operationId', 'actorId', 'operation', 'businessId', 'branchId',
          'ownerEmail', 'businessName', 'firstName', 'lastName', 'months', 'maxActiveBranches', 'maxRegisteredBranches', 'expiry', 'createdAt'])
        && d.actorId == request.auth.uid && id == request.auth.uid + '_' + d.operationId
        && d.operationId.matches('^[A-Za-z0-9_-]{16,100}$') && d.businessId == d.operationId
        && d.branchId == 'main_' + d.businessId && d.businessId != 'platform-admin'
        && d.businessName is string && d.businessName.size() > 0 && d.businessName.size() <= 120
        && d.firstName is string && d.firstName.size() > 0 && d.firstName.size() <= 120
        && d.lastName is string && d.lastName.size() > 0 && d.lastName.size() <= 120
        && d.ownerEmail is string && d.ownerEmail.size() <= 254
        && d.ownerEmail.matches('^[^ /@]+@[^ /@]+[.][^ /@]+$') && d.ownerEmail == d.ownerEmail.lower()
        && d.ownerEmail != currentUser().email && d.ownerEmail != request.auth.token.get('email', '')
        && d.months is int && d.months >= 1 && d.months <= 120
        && validBranchLimits(d)
        && d.createdAt == request.time && d.expiry is timestamp && d.expiry > request.time
        && d.expiry <= request.time + duration.value(d.months * 32, 'd')
        && !exists(/databases/$(database)/documents/tenants/$(d.businessId))
        && getAfter(/databases/$(database)/documents/tenants/$(d.businessId)).data.operationId == d.operationId
        && getAfter(/databases/$(database)/documents/licenses/$(d.businessId)).data.operationId == d.operationId
        && getAfter(/databases/$(database)/documents/branches/$(d.branchId)).data.operationId == d.operationId
        && getAfter(/databases/$(database)/documents/settings/$(d.businessId)).data.operationId == d.operationId
        && getAfter(/databases/$(database)/documents/invites/$(d.ownerEmail)).data.operationId == d.operationId
        && getAfter(/databases/$(database)/documents/owner_email_claims/$(d.ownerEmail)).data.operationId == d.operationId;
    }
    function provisionTenant(id) {
      let d = request.resource.data;
      let op = provisioning(d);
      return newProvision(d) && id == op.businessId
        && d == { 'businessId': id, 'businessName': op.businessName, 'ownerEmail': op.ownerEmail,
          'status': 'active', 'schemaVersion': 1, 'operationId': op.operationId, 'createdAt': request.time };
    }
    function provisionLicense(id) {
      let d = request.resource.data;
      let op = provisioning(d);
      return newProvision(d) && id == op.businessId
        && d == { 'businessId': id, 'businessName': op.businessName, 'status': 'activa', 'tenantStatus': 'active',
          'expiry': op.expiry, 'maxActiveBranches': op.maxActiveBranches, 'maxRegisteredBranches': op.maxRegisteredBranches,
          'activeBranchIds': [op.branchId], 'registeredBranchIds': [op.branchId],
          'branchQuotaVersion': 1, 'registeredBranchQuotaVersion': 1, 'operationId': op.operationId, 'createdAt': request.time };
    }
    function provisionBranch(id) {
      let d = request.resource.data;
      let op = provisioning(d);
      return newProvision(d) && id == op.branchId
        && d == { 'businessId': op.businessId, 'name': 'Sede Principal', 'address': 'Dirección por definir',
          'phone': '', 'status': 'activo', 'sparkCashVersion': 1, 'branchLifecycleVersion': 1, 'operationId': op.operationId, 'createdAt': request.time };
    }
    function provisionSettings(id) {
      let d = request.resource.data;
      let op = provisioning(d);
      return newProvision(d) && id == op.businessId
        && d == { 'businessId': id, 'operationId': op.operationId,
          'companyData': { 'razonSocial': op.businessName, 'ruc': '', 'direccion': 'Dirección por definir', 'telefono': '' } };
    }
    function provisionInvite(id) {
      let d = request.resource.data;
      let op = provisioning(d);
      return newProvision(d) && id == op.ownerEmail
        && d == { 'businessId': op.businessId, 'email': id, 'firstName': op.firstName, 'lastName': op.lastName,
          'role': 'dueño', 'branchId': 'global', 'shiftStart': null, 'shiftEnd': null, 'status': 'activo',
          'createdAt': request.time, 'operationId': op.operationId };
    }
    function provisionClaim(id) {
      let d = request.resource.data;
      let op = provisioning(d);
      return newProvision(d) && id == op.ownerEmail
        && d == { 'businessId': op.businessId, 'email': id, 'operationId': op.operationId, 'createdAt': request.time };
    }
    function licenseBaseExpiry(data) {
      return data.get('expiry', null) is timestamp && data.expiry > request.time ? data.expiry : request.time;
    }
    function mutableLicense(data) {
      return data.get('tenantStatus', 'active') == 'active' && data.get('maintenanceJobId', null) == null
        && (!exists(/databases/$(database)/documents/tenants/$(data.businessId))
          || (get(/databases/$(database)/documents/tenants/$(data.businessId)).data.status == 'active'
            && get(/databases/$(database)/documents/tenants/$(data.businessId)).data.get('maintenanceJobId', null) == null));
    }
    function licenseChange(id) {
      let d = request.resource.data;
      let op = provisioning(d);
      return superadmin() && mutableLicense(resource.data) && businessUnchanged() && id == d.businessId
        && op.actorId == request.auth.uid && op.businessId == id && op.createdAt == request.time
        && !exists(/databases/$(database)/documents/platform_operations/$(request.auth.uid + '_' + d.operationId))
        && d.updatedAt == request.time && d.status == op.newStatus
        && d.diff(resource.data).affectedKeys().hasOnly(['operationId', 'status', 'expiry', 'updatedAt'])
        && ((op.operation == 'extendTenantLicense' && d.expiry == op.expiry && d.status == 'activa'
            && d.expiry > licenseBaseExpiry(resource.data)
            && d.expiry <= licenseBaseExpiry(resource.data) + duration.value(op.months * 32, 'd'))
          || (op.operation == 'setTenantLicenseStatus' && d.status in ['activa', 'inactiva']
            && !d.diff(resource.data).affectedKeys().hasAny(['expiry'])));
    }
    function licenseReceipt(id) {
      let d = request.resource.data;
      let license = getAfter(/databases/$(database)/documents/licenses/$(d.businessId)).data;
      return superadmin() && id == request.auth.uid + '_' + d.operationId && d.actorId == request.auth.uid
        && d.operationId.matches('^[A-Za-z0-9_-]{16,100}$') && d.createdAt == request.time
        && license.operationId == d.operationId && license.updatedAt == request.time && license.status == d.newStatus
        && ((d.operation == 'extendTenantLicense'
            && d.keys().hasOnly(['operationId', 'actorId', 'operation', 'businessId', 'months', 'newStatus', 'expiry', 'createdAt'])
            && d.months is int && d.months >= 1 && d.months <= 120 && d.expiry == license.expiry)
          || (d.operation == 'setTenantLicenseStatus'
            && d.keys().hasOnly(['operationId', 'actorId', 'operation', 'businessId', 'newStatus', 'createdAt'])));
    }

    function validBranchLimits(data) {
      return data.maxActiveBranches is int && data.maxActiveBranches >= 1 && data.maxActiveBranches <= 100
        && data.maxRegisteredBranches is int && data.maxRegisteredBranches >= data.maxActiveBranches
        && data.maxRegisteredBranches <= 200;
    }
    function configuredQuota(license) {
      let active = license.activeBranchIds;
      let registered = license.registeredBranchIds;
      return license.get('branchQuotaVersion', 0) == 1 && license.get('registeredBranchQuotaVersion', 0) == 1
        && validBranchLimits(license)
        && active is list && active.size() >= 1 && active.size() <= license.maxActiveBranches
        && active.toSet().size() == active.size()
        && registered is list && registered.size() >= 1 && registered.size() <= license.maxRegisteredBranches
        && registered.toSet().size() == registered.size() && registered.hasAll(active);
    }
    // Only SuperAdmin may set limits or attest a first historical inventory.
    // Registered IDs are permanent: neither owners nor later quota edits release them.
    function quotaLicenseChange(id) {
      let d = request.resource.data;
      let op = getAfter(/databases/$(database)/documents/platform_operations/$(request.auth.uid + '_' + d.quotaOperationId)).data;
      return superadmin() && businessUnchanged() && id == d.businessId && configuredQuota(d)
        && d.diff(resource.data).affectedKeys().hasOnly(['maxActiveBranches', 'maxRegisteredBranches', 'activeBranchIds', 'registeredBranchIds',
          'branchQuotaVersion', 'registeredBranchQuotaVersion', 'quotaOperationId', 'branchQuotaUpdatedAt'])
        && (resource.data.get('branchQuotaVersion', 0) != 1 || d.activeBranchIds == resource.data.activeBranchIds)
        && (resource.data.get('registeredBranchQuotaVersion', 0) != 1 || d.registeredBranchIds == resource.data.registeredBranchIds)
        && op.regularization == (resource.data.get('branchQuotaVersion', 0) != 1 || resource.data.get('registeredBranchQuotaVersion', 0) != 1)
        && d.branchQuotaUpdatedAt == request.time && op.createdAt == request.time
        && op.operation == 'setTenantBranchQuota' && op.actorId == request.auth.uid && op.businessId == id
        && op.maxActiveBranches == d.maxActiveBranches && op.maxRegisteredBranches == d.maxRegisteredBranches
        && op.activeBranchIds == d.activeBranchIds && op.registeredBranchIds == d.registeredBranchIds
        && !exists(/databases/$(database)/documents/platform_operations/$(request.auth.uid + '_' + d.quotaOperationId));
    }
    function quotaReceipt(id) {
      let d = request.resource.data;
      let license = getAfter(/databases/$(database)/documents/licenses/$(d.businessId)).data;
      return superadmin() && id == request.auth.uid + '_' + d.operationId && d.actorId == request.auth.uid
        && d.operationId.matches('^[A-Za-z0-9_-]{16,100}$') && d.operation == 'setTenantBranchQuota'
        && d.keys().hasOnly(['actorId', 'businessId', 'operationId', 'operation', 'maxActiveBranches', 'maxRegisteredBranches',
          'activeBranchIds', 'registeredBranchIds', 'regularization', 'createdAt'])
        && d.createdAt == request.time && d.regularization is bool && configuredQuota(license)
        && license.quotaOperationId == d.operationId && license.branchQuotaUpdatedAt == request.time
        && license.maxActiveBranches == d.maxActiveBranches && license.maxRegisteredBranches == d.maxRegisteredBranches
        && license.activeBranchIds == d.activeBranchIds && license.registeredBranchIds == d.registeredBranchIds;
    }
    function branchInventoryChange(id, data, wasActive, creating) {
      let before = get(/databases/$(database)/documents/licenses/$(data.businessId)).data;
      let after = getAfter(/databases/$(database)/documents/licenses/$(data.businessId)).data;
      return configuredQuota(before) && configuredQuota(after)
        && after.branchQuotaBranchId == id && after.branchQuotaUpdatedAt == request.time
        && (creating ? (!before.registeredBranchIds.hasAny([id])
            && after.registeredBranchIds == before.registeredBranchIds.concat([id])
            && (data.status == 'activo' ? after.activeBranchIds == before.activeBranchIds.concat([id])
              : (data.status == 'inactivo' && after.activeBranchIds == before.activeBranchIds)))
          : (before.registeredBranchIds.hasAny([id]) && after.registeredBranchIds == before.registeredBranchIds
            && (wasActive ? (before.activeBranchIds.hasAny([id]) && data.status == 'inactivo'
                && after.activeBranchIds == before.activeBranchIds.removeAll([id]))
              : (!before.activeBranchIds.hasAny([id]) && data.status == 'activo'
                && after.activeBranchIds == before.activeBranchIds.concat([id])))));
    }
    function branchQuotaChange(id) {
      let d = request.resource.data;
      let key = d.branchQuotaBranchId;
      let before = get(/databases/$(database)/documents/branches/$(key));
      let after = getAfter(/databases/$(database)/documents/branches/$(key));
      return tenantManager() && id == currentBusiness()
        && d.diff(resource.data).affectedKeys().hasOnly(['activeBranchIds', 'registeredBranchIds', 'branchQuotaBranchId', 'branchQuotaUpdatedAt'])
        && after != null && after.data.businessId == id
        && (before == null || before.data.businessId == id)
        && branchInventoryChange(key, after.data, before != null && before.data.get('status', null) == 'activo', before == null);
    }
    function branchCreation(id) {
      let d = request.resource.data;
      return tenantCreator() && validNamedRecord()
        && d.sparkCashVersion == 1 && d.branchLifecycleVersion == 1
        && d.keys().hasOnly(['businessId', 'name', 'address', 'phone', 'status', 'yapeQrUrl', 'createdAt', 'updatedAt', 'sparkCashVersion', 'branchLifecycleVersion'])
        && branchInventoryChange(id, d, false, true);
    }
    function branchUpdate(id) {
      let d = request.resource.data;
      return tenantManager() && businessUnchanged() && validNamedRecord()
        && d.diff(resource.data).affectedKeys().hasOnly(['name', 'address', 'phone', 'status', 'yapeQrUrl', 'updatedAt'])
        && (d.status == resource.data.get('status', null) ||
          (d.status == 'activo' ? branchInventoryChange(id, d, false, false) :
            (d.status == 'inactivo' && resource.data.get('branchLifecycleVersion', 0) == 1
              && !exists(/databases/$(database)/documents/active_cash_sessions/$(cashLockId(d.businessId, id)))
              && branchInventoryChange(id, d, true, false))));
    }

    function cashLockId(businessId, branchId) {
