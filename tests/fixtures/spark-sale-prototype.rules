// TEST ONLY. Never referenced by firebase.json or shipped as operational Rules.
// Feasibility boundary: 1..2 distinct products, one branch/session, online only.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function actor() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function lockId(businessId, branchId) { return hashing.sha256('["' + businessId + '","' + branchId + '"]').toHexString().lower(); }
    function context(d) {
      let user = actor();
      let license = get(/databases/$(database)/documents/licenses/$(d.businessId)).data;
      let tenant = get(/databases/$(database)/documents/tenants/$(d.businessId)).data;
      let branch = get(/databases/$(database)/documents/branches/$(d.branchId)).data;
      let session = get(/databases/$(database)/documents/cash_sessions/$(d.sessionId)).data;
      let lock = get(/databases/$(database)/documents/active_cash_sessions/$(lockId(d.businessId, d.branchId))).data;
      return request.auth != null && user.status == 'activo' && user.role in ['dueño', 'cajero']
        && user.businessId == d.businessId && d.userId == request.auth.uid
        && (user.role == 'dueño' || user.branchId == d.branchId)
        && license.businessId == d.businessId && license.status == 'activa' && license.expiry > request.time
        && license.get('tenantStatus', 'active') == 'active' && license.get('maintenanceJobId', null) == null
        && tenant.status == 'active' && tenant.get('maintenanceJobId', null) == null
        && branch.businessId == d.businessId && branch.status == 'activo' && branch.sparkCashVersion == 1
        && session.userId == d.userId && session.businessId == d.businessId && session.branchId == d.branchId
        && session.status == 'open' && session.runtime == 'spark' && session.openedAt <= request.time
        && lock.sessionId == d.sessionId && lock.userId == d.userId && lock.status == 'open';
    }
    function line(d, index) {
      let item = d.items[index];
      let product = getAfter(/databases/$(database)/documents/products/$(item.id)).data;
      return item.keys().hasOnly(['id', 'name', 'category', 'qty', 'price', 'cost']) && item.id == d.productIds[index]
        && item.qty is int && item.qty > 0 && item.qty <= 1000000
        && product.businessId == d.businessId && product.get('status', 'activo') == 'activo'
        && item.price == product.price && item.cost == product.get('cost', 0)
        && item.name == product.name && item.category == product.get('category', '')
        && product.posLastSaleId == d.saleId;
    }
    function slot(d, index) { return d.items.size() <= index || line(d, index); }
    function price(d, index) { return d.items.size() <= index ? 0 : math.round(d.items[index].price * 100) * d.items[index].qty; }
    function cost(d, index) { return d.items.size() <= index ? 0 : math.round(d.items[index].cost * 100) * d.items[index].qty; }
    function cents(value) { return value is number && value >= 0 && value <= 1000000000 && value == math.round(value * 100) / 100.0; }
    function validPayment(d) {
      return d.payment == 'efectivo'
        ? cents(d.amountPaid) && d.amountPaid >= d.total && d.change == (math.round(d.amountPaid * 100) - math.round(d.total * 100)) / 100.0
        : d.amountPaid == d.total && d.change == 0 && (d.payment == 'yape' || (d.payment == 'mixto' && mixedPayment(d)));
    }
    function mixedPayment(d) {
      let split = d.splitPayments;
      // The second component is derived exactly, avoiding duplicate evaluation.
      return split.keys().hasOnly(['efectivo', 'yape']) && cents(split.efectivo) && split.efectivo <= d.total
        && split.yape == (math.round(d.total * 100) - math.round(split.efectivo * 100)) / 100.0;
    }
    function sale(id) {
      let d = request.resource.data;
      let total = price(d, 0) + price(d, 1);
      let totalCost = cost(d, 0) + cost(d, 1);
      return context(d) && d.keys().hasOnly(['saleId', 'localId', 'idempotencyKey', 'version', 'businessId', 'branchId', 'userId', 'sessionId',
          'items', 'total', 'totalCost', 'grossProfit', 'payment', 'amountPaid', 'change', 'splitPayments', 'createdAt', 'queuedAt', 'origin', 'cashierName', 'productIds', 'confirmedAt', 'status'])
        && d.saleId == id && d.localId == id && d.idempotencyKey == id && d.version == 1
        && d.origin == 'online' && d.status == 'confirmed' && d.confirmedAt == request.time
        && d.createdAt is string && d.queuedAt is string
        && d.items is list && d.items.size() >= 1 && d.items.size() <= 2
        && d.productIds is list && d.productIds.size() == d.items.size() && d.productIds.toSet().size() == d.items.size()
        && slot(d, 0) && slot(d, 1)
        && cents(d.total) && d.total > 0 && math.round(d.total * 100) == total
        && cents(d.totalCost) && math.round(d.totalCost * 100) == totalCost
        && d.grossProfit == (total - totalCost) / 100.0 && validPayment(d);
    }
    function debitAt(d, productId, index) {
      return d.items.size() > index && d.items[index].id == productId
        && request.resource.data.stock[d.branchId] == resource.data.stock[d.branchId] - d.items[index].qty;
    }
    function debit(productId) {
      let d = getAfter(/databases/$(database)/documents/sales/$(request.resource.data.posLastSaleId)).data;
      return request.auth != null && d.userId == request.auth.uid && d.businessId == resource.data.businessId
        && d.confirmedAt == request.time && !exists(/databases/$(database)/documents/sales/$(d.saleId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'posStockVersion', 'posLastSaleId'])
        && request.resource.data.posStockVersion == resource.data.get('posStockVersion', 0) + 1
        && request.resource.data.stock.diff(resource.data.stock).affectedKeys().hasOnly([d.branchId])
        && request.resource.data.stock[d.branchId] is int && request.resource.data.stock[d.branchId] >= 0
        && (debitAt(d, productId, 0) || debitAt(d, productId, 1));
    }
    match /sales/{id} {
      allow get: if request.auth != null && (resource == null || (actor().businessId == resource.data.businessId && actor().role in ['dueño', 'cajero']
        && (actor().role == 'dueño' || actor().branchId == resource.data.branchId)));
      allow create: if sale(id);
      allow update, delete: if false;
    }
    match /products/{id} {
      allow get: if request.auth != null && actor().businessId == resource.data.businessId;
      allow update: if debit(id);
      allow create, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
