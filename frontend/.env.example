# Public Firebase Web configuration. Copy to .env.local and fill in your web app values.
# Never put service accounts, private keys or server-side tokens in VITE_* variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: Analytics stays disabled when this is empty.
VITE_FIREBASE_MEASUREMENT_ID=
# Optional existing HTTPS support/billing channels. Leave empty when not configured.
VITE_SUPPORT_URL=
VITE_BILLING_URL=
# Optional explicit environment: production, emulator (demo-migapos), or a future independent staging.
VITE_APP_ENV=
VITE_USE_EMULATORS=
# Progressive App Check: off by default; monitor requires a real PUBLIC Enterprise site key.
VITE_APP_CHECK_MODE=off
VITE_APP_CHECK_SITE_KEY=
